# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
# Postgres connection string used by scripts/{apply-migration,verify-migrations,smoke-test-commission,generate-epp-invites}.mjs.
# Copy from Supabase → Project Settings → Database → Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Auth
JWT_SECRET=change-this-to-a-secure-random-string
NEXT_PUBLIC_APP_DOMAIN=operon.app

# Admin (server-side contract writer + admin endpoint allowlist)
ADMIN_WALLETS=0x...          # lowercase comma-separated list
ADMIN_PRIVATE_KEY=0x...      # testnet only — Gnosis Safe before mainnet

# RPC Providers
NEXT_PUBLIC_ALCHEMY_KEY=your-alchemy-key
NEXT_PUBLIC_QUICKNODE_URL=https://your-endpoint.quiknode.pro/      # Arbitrum QuickNode endpoint (optional)
NEXT_PUBLIC_BSC_QUICKNODE_URL=https://your-bsc-endpoint.quiknode.pro/   # BSC QuickNode endpoint (optional but strongly recommended — public BSC RPCs rate-limit aggressively)

# Wallet connectors
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id  # Register free at https://cloud.walletconnect.com — required for WalletConnect mobile in the RainbowKit modal. Without this, only injected wallets (MetaMask, Rabby, etc.) and Coinbase Wallet show.

# Chain RPC (server-side, primary + fallback)
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL_FALLBACK=https://your-arb-quicknode.quiknode.pro/
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_RPC_URL_FALLBACK=https://your-bsc-quicknode.quiknode.pro/

# Deployment (contracts/) — consumed by contracts/hardhat.config.ts + scripts/deploy.ts
TREASURY_ADDRESS=0x...          # multi-sig address for receiving sale proceeds
DEPLOYER_PRIVATE_KEY=0x...      # deployer wallet — never commit this
TOKEN_DECIMALS=6                # 6 for Arbitrum USDC/USDT, 18 for BSC
# NodeSale v2 voucher checkout — the address whose private key (held off-chain
# in VOUCHER_SIGNER_PRIVATE_KEY, server-only) signs every PurchaseVoucher.
# The contract verifies signatures against this public address; rotate via
# setVoucherSigner from the owner Safe if the signer key is ever compromised.
VOUCHER_SIGNER_ADDRESS=0x...
# Per-chain hard cap per tier (safety net — backend is the global truth via
# sale_reservations + sale_tiers.total_sold). Default 1250 mirrors the 50%
# split of a 2500-supply tier across two chains, but the cap is intentionally
# slack so the backend can route all volume to one chain if the other is down.
LOCAL_TIER_CAP=1250
# Per-tier admin allocation budget for adminMint (giveaways / OTC / partner
# allocations not routed through voucher checkout). 1250 matches LOCAL_TIER_CAP
# but is independent — admin mints don't consume the local cap.
ADMIN_CAP_PER_TIER=1250
# Testnet Hardhat network URLs (only needed when running contracts/ scripts):
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# Mock-token addresses used by contracts/scripts/mint-test-tokens.ts after deploy.
# Paste the addresses printed by deploy.ts once per chain — chain-appropriate:
USDC_ADDRESS=0x...              # the USDC mock on the chain you're targeting
USDT_ADDRESS=0x...              # the USDT mock on the chain you're targeting

# Voucher signer private key — server-side only, NEVER NEXT_PUBLIC_, NEVER
# committed. Used by lib/voucher.ts to EIP-712-sign PurchaseVoucher payloads
# returned from /api/sale/reserve. The corresponding public address is
# VOUCHER_SIGNER_ADDRESS above and must match what the contract was deployed
# with (or last setVoucherSigner'd to). Rotate by: (1) generate new keypair,
# (2) deploy update via Safe.setVoucherSigner(newAddress), (3) swap this env
# var on the API. Active vouchers signed with the old key remain valid until
# their deadline expires.
VOUCHER_SIGNER_PRIVATE_KEY=0x...

# Upstash Redis (for rate limiting + nonce store) — required in production
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Network Mode (testnet or mainnet — defaults to mainnet)
NEXT_PUBLIC_NETWORK_MODE=testnet

# Contract Addresses (used by frontend via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SALE_CONTRACT_ARB=0x...
NEXT_PUBLIC_SALE_CONTRACT_BSC=0x...
NEXT_PUBLIC_NODE_CONTRACT_ARB=0x...
NEXT_PUBLIC_NODE_CONTRACT_BSC=0x...

# Server-side contract addresses (used by webhooks/cron)
SALE_CONTRACT_ARBITRUM=0x...
SALE_CONTRACT_BSC=0x...

# Testnet mock token addresses (only needed when NETWORK_MODE=testnet)
NEXT_PUBLIC_TESTNET_USDC_ARB=0x...
NEXT_PUBLIC_TESTNET_USDT_ARB=0x...
NEXT_PUBLIC_TESTNET_USDC_BSC=0x...
NEXT_PUBLIC_TESTNET_USDT_BSC=0x...

# Mainnet stablecoin addresses — read by /api/admin/sale/balance to report
# USDC + USDT held in each NodeSale contract. Unset on mainnet leaves the
# four balance tiles rendering "n/a" with no hint. Paste the canonical
# token addresses from each chain's token registry before flipping
# NEXT_PUBLIC_NETWORK_MODE=mainnet.
NEXT_PUBLIC_USDC_ARB=0x...   # Arbitrum One USDC, 6 decimals
NEXT_PUBLIC_USDT_ARB=0x...   # Arbitrum One USDT, 6 decimals
NEXT_PUBLIC_USDC_BSC=0x...   # BNB Chain USDC, 18 decimals
NEXT_PUBLIC_USDT_BSC=0x...   # BNB Chain USDT, 18 decimals

# Webhook Secrets
ALCHEMY_WEBHOOK_SIGNING_KEY=your-alchemy-webhook-signing-key
QUICKNODE_WEBHOOK_SECRET=your-quicknode-webhook-secret

# Cron
CRON_SECRET=your-cron-secret

# Notifications
TG_BOT_TOKEN=your-telegram-bot-token
TG_ADMIN_CHAT_ID=your-telegram-chat-id

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ─── Dev endpoints — LOCAL DEVELOPMENT ONLY ─────────────────────────
# Gates /api/dev/indexer-ingest and /api/dev/drain-referrals.
# All three conditions must hold for dev endpoints to work:
#   1. NODE_ENV !== 'production'
#   2. DEV_ENDPOINTS_ENABLED === '1'
#   3. request carries x-dev-signature HMAC of body with DEV_INDEXER_SECRET
# Must NEVER be set in a production or staging deploy.
#
# Both lines are commented out in this template. Testers uncomment them
# (and generate a real DEV_INDEXER_SECRET) per TESTING_GUIDE.md §3.6.
# A Vercel deploy that accidentally consumes this file as-is will fail
# closed — dev endpoints will not accept ingests.
# DEV_ENDPOINTS_ENABLED=1
# DEV_INDEXER_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
